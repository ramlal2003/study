%%%%%%%% Big M Method %%%%%%%%%%%%%%%%
% max z = 2x1 + 5x2
% x1 + 4x2 <= 24
% 3x1 + x2 <= 21
% x1 + x2 <= 9

clc
clear all
format short
M = 1e5;
C = [2 5];
a = [1 4; 3 1; 1 1];
b = [24; 21; 9];

[m,n] = size(a);
s = eye(m);
A_art = zeros(m,m);
A = [a s A_art b];
cost = zeros(1, size(A,2));
cost(1:n) = C;
cost(n+m+1:n+2*m) = -M;
bv = n+m+1 : n+2*m;
zjcj = cost(bv)*A - cost;
zcj = [A; zjcj];

disp('Initial Table:')
array2table(zcj, ...
    'VariableNames',{'x1','x2','s1','s2','s3','A1','A2','A3','sol'})
RUN = true;
while RUN
    if any(zjcj < 0)
        fprintf('Current BFS is not optimal\n')

        zc = zjcj(1:end-1);
        [~, pvt_col] = min(zc);

        if all(A(:,pvt_col) <= 0)
            error('LPP is Unbounded');
        else
            sol = A(:,end);
            column = A(:,pvt_col);

            ratio = inf(m,1);
            for i=1:m
                if column(i) > 0
                    ratio(i) = sol(i)/column(i);
                end
            end

            [~, pvt_row] = min(ratio);
        end

        bv(pvt_row) = pvt_col;
        pvt_key = A(pvt_row,pvt_col);

        A(pvt_row,:) = A(pvt_row,:) / pvt_key;

        for i=1:m
            if i ~= pvt_row
                A(i,:) = A(i,:) - A(i,pvt_col)*A(pvt_row,:);
            end
        end

        zjcj = zjcj - zjcj(pvt_col)*A(pvt_row,:);
        zcj = [A; zjcj];

        disp('Next Table:')
        array2table(zcj, ...
         'VariableNames',{'x1','x2','s1','s2','s3','A1','A2','A3','sol'})

    else
        RUN = false;
        fprintf('Optimal solution reached\n')
    end
end

solution = zeros(1, size(A,2));
solution(bv) = A(:,end);

fprintf('Optimal Value Z = %f\n', zjcj(end))
